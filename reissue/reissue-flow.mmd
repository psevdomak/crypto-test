---
config:
  theme: base
  htmlLabels: false
  themeCSS: |
    text { font-family: system-ui, sans-serif; }
    .background { fill: #fff; }
  themeVariables:
    fontFamily: 'system-ui, sans-serif'
    fontSize: '17px'
    primaryColor: '#f3f6fa'
    primaryTextColor: '#17273b'
    primaryBorderColor: '#8c9db2'
    lineColor: '#576e87'
    edgeLabelBackground: '#ffffff'
  flowchart:
    curve: linear
    nodeSpacing: 24
    rankSpacing: 36
---
flowchart TD
    accTitle: Динамическая генерация ключей
    accDescr: Выбор формата ключа по серийному номеру Рутокена, повторная генерация, фолбэк и очистка контейнеров.
    START([Пользователь нажимает «Сгенерировать»])
    SINGLE{"Виден ровно один<br/>однозначно определённый Рутокен?"}
    DIRECT["Запросить формат и создать один контейнер<br/>Если API или режим недоступны,<br/>генерировать по обычным правилам"]
    DIRECTDONE([Вернуть итоговый CSR])
    DIRECTFAIL([Завершить прогон с ошибкой])
    FIRST["КриптоПро создаёт первый контейнер и CSR"]
    TOKEN{"Какой носитель и формат<br/>у первого контейнера?"}
    API["Запросить формат у key-format<br/>по серийному номеру Рутокена"]
    FORMAT{"Какой формат вернул API?"}
    SECOND["Создать и проверить второй контейнер<br/>на том же Рутокене в нужном формате"]
    RESULT{"Итог второй генерации"}
    CLEAN["Удалить первый контейнер"]
    KEEP([Вернуть первый CSR])
    DONE([Вернуть второй CSR])
    FAIL([Завершить прогон с ошибкой])

    START --> SINGLE
    SINGLE -->|Да| DIRECT
    SINGLE -->|Нет или ошибка перечисления| FIRST
    DIRECT -->|Успех| DIRECTDONE
    DIRECT -->|Ошибка или отмена| DIRECTFAIL
    FIRST -->|Успех| TOKEN
    FIRST -->|Ошибка или отмена| FAIL
    TOKEN -->|Другой носитель| KEEP
    TOKEN -->|Рутокен в CSP или PKCS11| API
    TOKEN -->|FKS или ошибка идентификации| DROP1["Попытаться удалить первый контейнер"] --> FAIL

    API --> FORMAT
    FORMAT -->|Текущий формат, неизвестный ответ или ошибка API| KEEP
    FORMAT -->|Другой поддерживаемый формат| SECOND
    SECOND --> RESULT
    RESULT -->|Не удалось выбрать нужный режим на Рутокене или создать второй контейнер| KEEP
    RESULT -->|Пользователь отменил| DROP1
    RESULT -->|Успех| CLEAN
    CLEAN -->|Удалён| DONE
    CLEAN -->|Ошибка удаления| FAIL

    classDef choice fill:#e8effb,stroke:#6986b3,color:#182d51
    classDef success fill:#e8f5ec,stroke:#52785d,color:#1c4328
    classDef fallback fill:#fff4db,stroke:#97713a,color:#593d10
    classDef failure fill:#fceced,stroke:#ab6c72,color:#6f3136
    class TOKEN,FORMAT,RESULT,SINGLE choice
    class DONE,DIRECTDONE success
    class KEEP fallback
    class FAIL,DIRECTFAIL failure
